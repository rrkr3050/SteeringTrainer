<UserControl x:Class="SteeringTrainer.App.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SteeringTrainer.App.Converters"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左ペイン: コントロール -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="目標の速さでハンドルを回そう" Style="{StaticResource HeaderText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="目標と現在の速さを比べながら、左右に操作します。" Style="{StaticResource BaseText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <!-- 操作ボタン -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding StartStopText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}" Margin="0,0,4,0"
                        IsEnabled="{Binding IsRunning, Converter={x:Static converters:BoolInverterConverter.Instance}}"/>
                <Button Grid.Column="1" Content="停止" Style="{StaticResource SecondaryButton}"
                        Command="{Binding StopCommand}" Margin="4,0,0,0"/>
            </Grid>

            <Button Content="CSV エクスポート" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ExportCsvCommand}"/>

            <!-- 現在値 -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="現在の入力" Style="{StaticResource HeaderText}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="角度" Style="{StaticResource LabelText}" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentAngleText}" Style="{StaticResource ValueText}" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="角速度" Style="{StaticResource LabelText}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVelocityText}" Style="{StaticResource ValueText}" Foreground="LimeGreen" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="角加速度" Style="{StaticResource LabelText}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentAccelerationText}" Style="{StaticResource ValueText}" Foreground="OrangeRed" Margin="0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 目標設定 -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="練習の設定" Style="{StaticResource HeaderText}" Margin="0,0,0,8"/>

                    <TextBlock Text="プリセット" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                    <ComboBox ItemsSource="{Binding Presets}"
                              SelectedIndex="{Binding SelectedPresetIndex}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="最大舵角" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="180" Maximum="900"
                                Value="{Binding LockAngle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource BaseText}" FontSize="13"
                                   Text="{Binding LockAngle, StringFormat={}{0:F0}&#176;}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="片側にかける時間" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0.5" Maximum="5.0" TickFrequency="0.1"
                                Value="{Binding TimeSideSeconds}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource BaseText}" FontSize="13"
                                   Text="{Binding TimeSideSeconds, StringFormat={}{0:F1}s}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="目標角速度:" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding TargetVelocityText}" Style="{StaticResource BaseText}"
                                   FontSize="14" FontWeight="Bold" Foreground="Cyan" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 評価 -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="現在の判定" Style="{StaticResource HeaderText}" Margin="0,0,0,6"/>

                    <!-- GOOD/WARNING/MISS -->
                    <TextBlock Text="{Binding VerdictText}"
                               Foreground="{Binding VerdictBrush}"
                               FontFamily="Consolas" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4"/>

                    <!-- 角速度ゲージ -->
                    <ProgressBar Height="20" Maximum="1.5"
                                 Value="{Binding VelocityGaugeValue, Mode=OneWay}"
                                 Foreground="{Binding VerdictBrush}"
                                 Background="{StaticResource PrimaryBrush}"
                                 BorderThickness="0" Margin="0,6"/>
                    <TextBlock Text="目標に対する速さ" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>


        </StackPanel>
        </ScrollViewer>

        <!-- 右ペイン: 角度インジケータと平滑化角加速度グラフ -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ハンドルの位置" Style="{StaticResource HeaderText}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- ステアリング角度バー -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding LockAngle, StringFormat=+{0:F0}&#176;}"
                               Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>

                    <!-- 垂直バー表示 -->
                    <Border Grid.Row="1" Width="80" Height="300"
                            Background="{StaticResource PrimaryBrush}" CornerRadius="4" Margin="0,4">
                        <Canvas x:Name="SteeringCanvas" ClipToBounds="True">
                            <!-- センターライン -->
                            <Line X1="0" Y1="150" X2="80" Y2="150"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1"
                                  StrokeDashArray="4,4"/>
                        </Canvas>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{Binding LockAngle, StringFormat=-{0:F0}&#176;}"
                               Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="12,0">
                        <TextBlock Text="目標" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TargetVelocityText}" Style="{StaticResource BaseText}"
                                   FontSize="16" Foreground="Cyan" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="12,0">
                        <TextBlock Text="現在" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVelocityText}" Style="{StaticResource BaseText}"
                                   FontSize="16" Foreground="LimeGreen" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource BackgroundBrush}" CornerRadius="4"
                        Margin="0,8,0,0" Padding="6">
                    <oxy:PlotView Model="{Binding AccelerationPlotModel}" Background="Transparent"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
