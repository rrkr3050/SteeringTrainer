<UserControl x:Class="SteeringTrainer.App.Views.ThrottleTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:converters="clr-namespace:SteeringTrainer.App.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolInverterConverter x:Key="BoolInverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左ペイン: 設定・操作・リアルタイムゲージ・評価結果 -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ステータス & 操作カード -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="THROTTLE TRACKING" Style="{StaticResource HeaderText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding TimeRemainingText}" Style="{StaticResource ValueText}"
                                       Foreground="Cyan" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusTitle}"
                                   Foreground="{Binding StatusBrush}"
                                   FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4"/>

                        <TextBlock Text="{Binding StatusSubText}"
                                   Style="{StaticResource BaseText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,2,0,12"/>

                        <!-- 操作ボタン -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="START [Space]" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartCommand}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="STOP [Esc]" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopCommand}" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- メトロノーム設定 (セッション中も切り替え可能) -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,0">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" Content="メトロノーム音 (上下ピーク音)"
                                          IsChecked="{Binding EnableMetronome}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                          VerticalAlignment="Center"
                                          ToolTip="ONにすると目標Sin波の上下ピーク（最大アクセル・最小アクセル）到達時にメトロノーム音が鳴ります"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="音量:" Style="{StaticResource LabelText}" FontSize="10" Margin="0,0,4,0"/>
                                    <Slider Width="70" Minimum="0" Maximum="100" Value="{Binding MetronomeVolumePercent}"
                                            TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ToolTip="メトロノームの音量"/>
                                    <TextBlock Text="{Binding MetronomeVolumeText}" Style="{StaticResource BaseText}" FontSize="10" Margin="4,0,0,0" Width="30"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ペダル現在値 (LIVE INPUTS) -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LIVE PEDAL INPUTS" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>

                        <!-- BRAKE -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="BRAKE" Style="{StaticResource LabelText}" FontWeight="Bold" Foreground="OrangeRed" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="目標: " Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding TargetBrakeText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Yellow" Margin="0,0,8,0"/>
                                <TextBlock Text="現在: " Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding CurrentBrakeText}" Style="{StaticResource ValueText}" Foreground="OrangeRed"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Height="18" Maximum="100"
                                     Value="{Binding CurrentBrakePercent, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource PrimaryBrush}"
                                     BorderThickness="0" Margin="0,0,0,10"/>

                        <!-- THROTTLE -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="THROTTLE" Style="{StaticResource LabelText}" FontWeight="Bold" Foreground="LimeGreen" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="目標: " Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding CurrentTargetThrottleText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Yellow" Margin="0,0,8,0"/>
                                <TextBlock Text="現在: " Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding CurrentThrottleText}" Style="{StaticResource ValueText}" Foreground="LimeGreen"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Height="18" Maximum="100"
                                     Value="{Binding CurrentThrottlePercent, Mode=OneWay}"
                                     Foreground="{StaticResource GoodBrush}"
                                     Background="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- 評価結果カード (完了時に表示) -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="SESSION EVALUATION" Style="{StaticResource HeaderText}" Margin="0,0,0,8"/>

                        <!-- 総合スコア & グレード -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding GradeText}"
                                       Foreground="{Binding GradeBrush}"
                                       FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource BigValueText}"
                                       Foreground="Yellow" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- 3大基本評価 -->
                        <TextBlock Text="【基本評価】" Style="{StaticResource LabelText}" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="1. 波形精度 (40点)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding WaveformScoreText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="LimeGreen" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="2. 位相精度 (30点)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding PhaseScoreText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Cyan" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding PhaseLagText}" Style="{StaticResource LabelText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="3. ブレーキ安定性 (30点)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding BrakeStabilityScoreText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="OrangeRed" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- 詳細分析 -->
                        <TextBlock Text="【詳細追従分析】" Style="{StaticResource LabelText}" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="アクセル追従率" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ThrottleRatioText}" Style="{StaticResource BaseText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="ブレーキ維持率" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding BrakeRatioText}" Style="{StaticResource BaseText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="同時達成率" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding BothRatioText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Yellow" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="誤差精度 (踏み/戻し)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding RisingVsFallingErrorText}" Style="{StaticResource LabelText}" Foreground="Cyan" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="ブレーキ維持 (踏み/戻し)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding RisingVsFallingBrakeText}" Style="{StaticResource LabelText}" Foreground="Orange" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 設定パネル -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,12"
                        IsEnabled="{Binding CanEditSettings}">
                    <StackPanel>
                        <TextBlock Text="TRAINING SETTINGS" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

                        <!-- 目標ブレーキ量 -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="目標ブレーキ量" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding TargetBrakeText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="OrangeRed" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="5" Maximum="95" Value="{Binding TargetBrake}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                        <!-- ブレーキ許容幅 -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="ブレーキ許容幅 (±)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding BrakeToleranceText}" Style="{StaticResource BaseText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="20" Value="{Binding BrakeTolerance}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                        <!-- アクセル操作範囲 (Min / Max) -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="アクセル下限 (Min)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ThrottleMinText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="LimeGreen" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="90" Value="{Binding ThrottleMin}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="アクセル上限 (Max)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ThrottleMaxText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="LimeGreen" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" Value="{Binding ThrottleMax}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                        <!-- アクセル許容幅 -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="アクセル許容幅 (±)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ThrottleToleranceText}" Style="{StaticResource BaseText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="20" Value="{Binding ThrottleTolerance}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                        <!-- 波形速度 (BPM / 上ピーク基準) -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="波形速度 (BPM / 上ピーク基準)" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding CycleDurationText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Cyan" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="4" Maximum="200" Value="{Binding Bpm}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                        <!-- 練習時間 -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="練習時間" Style="{StaticResource LabelText}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding SessionDurationText}" Style="{StaticResource BaseText}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="180" Value="{Binding SessionDurationSeconds}" TickFrequency="10" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右ペイン: 2段リアルタイムOxyPlotプロット -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 上段: アクセル波形追従プロット (先読み表示) -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <oxy:PlotView Model="{Binding ThrottlePlotModel}"/>
            </Border>

            <!-- 下段: ブレーキ一定維持プロット -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8">
                <oxy:PlotView Model="{Binding BrakePlotModel}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
