<UserControl x:Class="SteeringTrainer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer Margin="16">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="DEVICE &amp; APP SETTINGS" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <!-- デバイス選択 -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Input Device" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableDevices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"
                              MinWidth="320"
                              Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="デバイス更新" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshDevicesCommand}" Margin="0,0,8,0"/>
                        <Button Content="適用 &amp; 保存" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyDeviceCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource LabelText}"
                                   Foreground="LimeGreen" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- リアルタイム Raw 軸モニター (非アクティブでも動作) -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="LIVE AXIS MONITOR (現在入力値)" Style="{StaticResource LabelText}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="6" Margin="0,0,0,4">
                        <StackPanel Margin="2,0">
                            <TextBlock Text="X (Steer)" Style="{StaticResource LabelText}" FontSize="10"/>
                            <TextBlock Text="{Binding RawX}" Style="{StaticResource BaseText}" FontSize="12" Foreground="Yellow"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Y" Style="{StaticResource LabelText}" FontSize="10"/>
                            <TextBlock Text="{Binding RawY}" Style="{StaticResource BaseText}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Z" Style="{StaticResource LabelText}" FontSize="10"/>
                            <TextBlock Text="{Binding RawZ}" Style="{StaticResource BaseText}" FontSize="12" Foreground="LimeGreen"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="R" Style="{StaticResource LabelText}" FontSize="10"/>
                            <TextBlock Text="{Binding RawR}" Style="{StaticResource BaseText}" FontSize="12" Foreground="OrangeRed"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="U" Style="{StaticResource LabelText}" FontSize="10"/>
                            <TextBlock Text="{Binding RawU}" Style="{StaticResource BaseText}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="V" Style="{StaticResource LabelText}" FontSize="10"/>
                            <TextBlock Text="{Binding RawV}" Style="{StaticResource BaseText}" FontSize="12"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="※ ペダルを踏んだ時に動く軸（ZやR等）とRaw値を確認し、下の校正欄に割り当ててください。"
                               Style="{StaticResource LabelText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ホイール設定 (GTFP 900° / 200° など) -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Wheel Settings (GTFP / Driving Force Pro)" Style="{StaticResource LabelText}" Margin="0,0,0,10"/>

                    <TextBlock Text="Wheel Rotation (総舵角)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding WheelRotationOptions}"
                              SelectedItem="{Binding SelectedWheelRotation}"
                              MinWidth="120"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Center Offset (&#176;)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="-30" Maximum="30"
                                Value="{Binding CenterOffset}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource BaseText}" FontSize="13"
                                   Text="{Binding CenterOffset, StringFormat={}{0:F1}&#176;}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Invert Input (入力反転)" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding InvertInput}" Margin="8,0,0,0"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ペダル軸・キャリブレーション -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Pedal Input &amp; Calibration (ペダル校正・ガンマ設定)" Style="{StaticResource LabelText}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatusText}" Style="{StaticResource LabelText}" Foreground="LimeGreen" FontSize="11"/>
                    </DockPanel>
                    <TextBlock Text="※ 各ペダルを未踏みの状態で「未踏み(0%)に設定」、最大まで踏み込んだ状態で「全踏み(100%)に設定」を押すだけで自動校正されます。ブレーキが途中で100%に達してしまう場合は、ガンマを1.5〜2.2（プログレッシブ）に設定してください。"
                               Style="{StaticResource LabelText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <!-- THROTTLE CARD -->
                    <Border Background="#FF131C31" CornerRadius="6" Padding="12" Margin="0,0,0,14" BorderBrush="#FF2A3B5C" BorderThickness="1">
                        <StackPanel>
                            <!-- ヘッダー & ライブ値表示 -->
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="THROTTLE (アクセル)" Style="{StaticResource BaseText}" Foreground="LimeGreen" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="現在Raw: " Style="{StaticResource LabelText}"/>
                                    <TextBlock Text="{Binding ThrottleCurrentRaw}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="LimeGreen" Margin="0,0,12,0"/>
                                    <TextBlock Text="認識入力値: " Style="{StaticResource LabelText}"/>
                                    <TextBlock Text="{Binding LiveThrottlePercent, StringFormat={}{0:F1}%}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="LimeGreen"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar Height="10" Maximum="100" Value="{Binding LiveThrottlePercent, Mode=OneWay}" Foreground="LimeGreen" Background="{StaticResource PrimaryBrush}" BorderThickness="0" Margin="0,0,0,10"/>

                            <!-- 軸割り当て & 反転設定 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="割り当て軸:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PedalAxisOptions}" SelectedItem="{Binding ThrottleAxis}"/>
                                <CheckBox Grid.Column="2" Content="入力反転 (Invert)" IsChecked="{Binding ThrottleInvert}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>

                            <!-- 0%点 & 100%点 設定 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 0%点 (未踏み) -->
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="0%点 (未踏み時 Raw)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="未踏み(0%)に設定" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding SetThrottle0PercentCommand}" Margin="6,0,0,0" ToolTip="アクセルから足を離した状態で押すと、現在のRaw値を0%に設定します"/>
                                            <TextBox Text="{Binding ThrottleRaw0, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Height="26"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 100%点 (全開) -->
                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="100%点 (全開時 Raw)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="全開(100%)に設定" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding SetThrottle100PercentCommand}" Margin="6,0,0,0" ToolTip="アクセルを床まで踏み込んだ状態で押すと、現在のRaw値を100%に設定します"/>
                                            <TextBox Text="{Binding ThrottleRaw100, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Height="26"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ガンマカーブ調整 -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="入力ガンマ (Gamma / カーブ特性):" Style="{StaticResource LabelText}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ThrottleGammaText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Foreground="LimeGreen"/>
                                    </DockPanel>
                                    <Slider Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Value="{Binding ThrottleGamma}" Margin="0,2,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- デッドゾーン設定 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="踏み始め遊び (0%側):" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ThrottleDeadzoneText}" Style="{StaticResource BaseText}" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ThrottleDeadzone}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="踏み切り遊び (100%側):" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ThrottleMaxDeadzoneText}" Style="{StaticResource BaseText}" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ThrottleMaxDeadzone}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BRAKE CARD -->
                    <Border Background="#FF131C31" CornerRadius="6" Padding="12" Margin="0,0,0,14" BorderBrush="#FF5C2A2A" BorderThickness="1">
                        <StackPanel>
                            <!-- ヘッダー & ライブ値表示 -->
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="BRAKE (ブレーキ)" Style="{StaticResource BaseText}" Foreground="OrangeRed" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text=" ※早期100%到達を防ぐにはガンマを1.5〜2.2へ調整" Style="{StaticResource LabelText}" FontSize="10" Margin="8,0,0,0" Foreground="#FFFFB74D" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="現在Raw: " Style="{StaticResource LabelText}"/>
                                    <TextBlock Text="{Binding BrakeCurrentRaw}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="OrangeRed" Margin="0,0,12,0"/>
                                    <TextBlock Text="認識入力値: " Style="{StaticResource LabelText}"/>
                                    <TextBlock Text="{Binding LiveBrakePercent, StringFormat={}{0:F1}%}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="OrangeRed"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar Height="10" Maximum="100" Value="{Binding LiveBrakePercent, Mode=OneWay}" Foreground="OrangeRed" Background="{StaticResource PrimaryBrush}" BorderThickness="0" Margin="0,0,0,10"/>

                            <!-- 軸割り当て & 反転設定 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="割り当て軸:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PedalAxisOptions}" SelectedItem="{Binding BrakeAxis}"/>
                                <CheckBox Grid.Column="2" Content="入力反転 (Invert)" IsChecked="{Binding BrakeInvert}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>

                            <!-- 0%点 & 100%点 設定 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 0%点 (未踏み) -->
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="0%点 (未踏み時 Raw)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="未踏み(0%)に設定" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding SetBrake0PercentCommand}" Margin="6,0,0,0" ToolTip="ブレーキから足を離した状態で押すと、現在のRaw値を0%に設定します"/>
                                            <TextBox Text="{Binding BrakeRaw0, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Height="26"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 100%点 (全開) -->
                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="100%点 (最大踏み込み時 Raw)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="全踏み(100%)に設定" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding SetBrake100PercentCommand}" Margin="6,0,0,0" ToolTip="ブレーキを力いっぱい踏み込んだ状態で押すと、現在のRaw値を100%に設定します"/>
                                            <TextBox Text="{Binding BrakeRaw100, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Height="26"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ガンマカーブ調整 -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="入力ガンマ (Gamma / カーブ特性):" Style="{StaticResource LabelText}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BrakeGammaText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Foreground="OrangeRed"/>
                                    </DockPanel>
                                    <Slider Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Value="{Binding BrakeGamma}" Margin="0,2,0,4"/>
                                    <TextBlock Text="※ 1.0=直線。1.5〜2.2（プログレッシブ）に設定すると、踏み始め〜中盤が緩やかになり、奥で強く踏み込むまで100%に達しにくくなります。"
                                               Style="{StaticResource LabelText}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- デッドゾーン設定 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="踏み始め遊び (0%側):" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BrakeDeadzoneText}" Style="{StaticResource BaseText}" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BrakeDeadzone}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="踏み切り遊び (100%側):" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BrakeMaxDeadzoneText}" Style="{StaticResource BaseText}" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BrakeMaxDeadzone}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CLUTCH CARD -->
                    <Border Background="#FF131C31" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#FF2A3B5C" BorderThickness="1">
                        <StackPanel>
                            <!-- ヘッダー & ライブ値表示 -->
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="CLUTCH (クラッチ / 任意)" Style="{StaticResource BaseText}" Foreground="Cyan" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="現在Raw: " Style="{StaticResource LabelText}"/>
                                    <TextBlock Text="{Binding ClutchCurrentRaw}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Cyan" Margin="0,0,12,0"/>
                                    <TextBlock Text="認識入力値: " Style="{StaticResource LabelText}"/>
                                    <TextBlock Text="{Binding LiveClutchPercent, StringFormat={}{0:F1}%}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="Cyan"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar Height="10" Maximum="100" Value="{Binding LiveClutchPercent, Mode=OneWay}" Foreground="Cyan" Background="{StaticResource PrimaryBrush}" BorderThickness="0" Margin="0,0,0,10"/>

                            <!-- 軸割り当て & 反転設定 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="割り当て軸:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PedalAxisOptions}" SelectedItem="{Binding ClutchAxis}"/>
                                <CheckBox Grid.Column="2" Content="入力反転 (Invert)" IsChecked="{Binding ClutchInvert}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>

                            <!-- 0%点 & 100%点 設定 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 0%点 (未踏み) -->
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="0%点 (未踏み時 Raw)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="未踏み(0%)に設定" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding SetClutch0PercentCommand}" Margin="6,0,0,0" ToolTip="クラッチから足を離した状態で押すと、現在のRaw値を0%に設定します"/>
                                            <TextBox Text="{Binding ClutchRaw0, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Height="26"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 100%点 (全開) -->
                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="100%点 (全踏み時 Raw)" Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="全踏み(100%)に設定" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding SetClutch100PercentCommand}" Margin="6,0,0,0" ToolTip="クラッチを床まで踏み込んだ状態で押すと、現在のRaw値を100%に設定します"/>
                                            <TextBox Text="{Binding ClutchRaw100, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" Height="26"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ガンマカーブ調整 -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="入力ガンマ (Gamma / カーブ特性):" Style="{StaticResource LabelText}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ClutchGammaText}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Foreground="Cyan"/>
                                    </DockPanel>
                                    <Slider Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Value="{Binding ClutchGamma}" Margin="0,2,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- デッドゾーン設定 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="踏み始め遊び (0%側):" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ClutchDeadzoneText}" Style="{StaticResource BaseText}" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ClutchDeadzone}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="踏み切り遊び (100%側):" Style="{StaticResource LabelText}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ClutchMaxDeadzoneText}" Style="{StaticResource BaseText}" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ClutchMaxDeadzone}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="ペダル設定を手動保存" Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- フィルタ設定 -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Signal Filter" Style="{StaticResource LabelText}" Margin="0,0,0,10"/>

                    <TextBlock Text="Filter Strength (EMAスムージング)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="50"
                                Value="{Binding FilterStrengthPercent}" VerticalAlignment="Center"
                                TickFrequency="10" IsSnapToTickEnabled="False"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource BaseText}" FontSize="13"
                                   Text="{Binding FilterStrengthPercent, StringFormat={}{0}%}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="※ 0% = フィルタなし（即時反映）　高くするほどノイズ低減・遅延微増"
                               Style="{StaticResource LabelText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
